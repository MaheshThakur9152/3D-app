# Mahesh 3D Environment Configuration Example
# Local development defaults are already provided in docker-compose.yml.
# For production deployment, override passwords and secrets.

PORT=5000
NODE_ENV=production
STORAGE_DIR=/app/storage
CORS_ORIGIN=*

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:devpassword123@postgres:5432/mahesh3d

# Redis / BullMQ Queue
REDIS_URL=redis://redis:6379
QUEUE_CONCURRENCY=2

# Optional Rhino.Compute remote licensing endpoint
# RHINO_COMPUTE_URL=http://your-rhino-compute:6500/
# RHINO_COMPUTE_KEY=your_token_here
